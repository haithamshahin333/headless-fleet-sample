# Headless Fleet portal: local settings. Copy to .env.local and fill in (.env.local is gitignored).
# In Kubernetes the Helm chart sets these from values.yaml; this file is for `npm run dev`.
# Server-only: none of these are NEXT_PUBLIC_, so none reach the browser and none are fixed at build time.
# The portal refuses to start, and lists what is wrong, when a required value is missing.

# ── Required ────────────────────────────────────────────────────────────────────
# The URL people open (no path). Also the redirect base: register
#   <AUTH_URL>/api/auth/callback/oidc
# as a redirect URI on the portal's app in your identity provider.
AUTH_URL=http://localhost:3100
# Encrypts the session cookie. Generate: openssl rand -base64 32
AUTH_SECRET=

# Your identity provider. Must equal LangSmith's FLEET_EXTERNAL_AUTH_OIDC_ISSUER_URL byte for byte.
#   Entra ID:  https://login.microsoftonline.com/<tenant-id>/v2.0
#   Keycloak:  https://keycloak.example.com/realms/<realm>
#   Okta:      https://<org>.okta.com/oauth2/<authorization-server-id>
OIDC_ISSUER=
# The portal's own app registration (client) in the identity provider.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# The audience LangSmith accepts: the same value as FLEET_EXTERNAL_AUTH_OIDC_AUDIENCE.
# The portal checks every sign-in against it and explains a mismatch on the login page.
OIDC_AUDIENCE=

# The LangSmith API. The portal calls <LANGSMITH_API_URL>/v1/fleet/*
LANGSMITH_API_URL=https://langsmith.example.com/api

# ── How the access token gets LangSmith's audience (one of these, by provider) ─
# Entra ID: the scope LangSmith's app exposes.
# OIDC_API_SCOPE=api://<langsmith-app-client-id>/Fleet.Access
# Auth0: sent as `audience` on sign-in.
# OIDC_AUDIENCE_PARAM=https://langsmith.example.com
# Keycloak / Okta: configured in the provider (audience mapper / authorization server); leave both unset.

# ── Identity claims ─────────────────────────────────────────────────────────────
# The claim LangSmith maps to a user: FLEET_EXTERNAL_AUTH_OIDC_SUBJECT_CLAIM. Entra ID: oid.
# OIDC_SUBJECT_CLAIM=sub
# Where the roles are in the id_token (a dot path): roles (Entra), groups (Okta), realm_access.roles (Keycloak).
# OIDC_ROLES_CLAIM=roles

# ── Optional ────────────────────────────────────────────────────────────────────
# Shown in the header, the tab title and the sign-in page.
# PORTAL_NAME=Agent Portal
# The sign-in button reads "Sign in with <OIDC_DISPLAY_NAME>".
# OIDC_DISPLAY_NAME=Microsoft
# Role values that unlock Build and Publish (comma-separated). Unset = Build is off for everyone.
# These are UX gating only: LangSmith decides what each person can actually do.
# PORTAL_BUILDER_ROLES=Portal.Builder,Portal.Platform
# Role values that see the "Admin in LangSmith" link.
# PORTAL_ADMIN_ROLES=Portal.Platform
# LANGSMITH_UI_URL=https://langsmith.example.com
# Skip org discovery / the workspace to fall back to when the workspace list is unavailable.
# LANGSMITH_ORG_ID=
# LANGSMITH_WORKSPACE_ID=
# Refresh the access token when fewer seconds than this remain (default 300).
# PORTAL_TOKEN_MIN_TTL_SEC=300
# Fleet OAuth provider used for the Computer → Microsoft Graph access profile.
# PORTAL_GRAPH_PROVIDER=microsoft-oauth-provider

# ── Development only ────────────────────────────────────────────────────────────
# PORTAL_DEV_LOGIN=1 replaces the identity provider with a persona picker and calls Fleet with
# ONE API key for everyone (LangSmith sees a single user). Refused when NODE_ENV=production.
# Works against LangSmith SaaS. Needs only AUTH_SECRET and LANGSMITH_API_KEY.
# PORTAL_DEV_LOGIN=1
# LANGSMITH_API_KEY=
# LANGSMITH_WORKSPACE_ID=
